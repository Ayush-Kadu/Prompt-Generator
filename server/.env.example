# ── Server ───────────────────────────────────────────────────────────────
# Express port. In dev the API always uses API_PORT (default 5000); in production PORT is honoured.
API_PORT=5000

# MongoDB connection string. Leave empty to keep runs in memory (lost on restart).
MONGODB_URI=mongodb://127.0.0.1:27017/prompt-generator

# ── Public API ───────────────────────────────────────────────────────────
# Comma-separated keys. When set, every /api/v1 call needs "Authorization: Bearer <key>" or "x-api-key".
# If you set this, also set VITE_ENGINE_API_KEY in client/.env so the web UI can call the API.
ENGINE_API_KEYS=
# Comma-separated origins allowed by CORS (empty = any origin)
CORS_ORIGINS=
RATE_LIMIT_PER_MINUTE=120
# Synchronous /prompts/generate is capped; larger jobs go through /runs
MAX_SYNC_PROMPTS=500
MAX_CONCURRENT_RUNS=2
# Parallel LLM calls inside one run
AGENT_CONCURRENCY=3

# ── LLM providers ────────────────────────────────────────────────────────
# Default provider: openai | anthropic | gemini | groq | mistral | deepseek | openrouter | ollama | custom | offline
# Empty = first configured provider, or offline templates when none are configured.
# Users can still pick any configured provider per request.
LLM_PROVIDER=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

GROQ_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Local models via Ollama (configured when the base URL is set)
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1

# Any other OpenAI-compatible endpoint
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_MODEL=
